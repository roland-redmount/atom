{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build debug",
			"type": "shell",
			"command": "make",
			"args": [
				"DEBUG=1"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build debug-allocate",
			"type": "shell",
			"command": "make",
			"args": [
				"DEBUG=1",
				"DEBUG_ALLOCATE=1"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build release",
			"type": "shell",
			"command": "make",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build single",
			"type": "shell",
			"command": "make",
			"args": [
				"${relativeFileDirname}/${fileBasenameNoExtension}.o"
				"DEBUG=1"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "make clean",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		}
	]
}