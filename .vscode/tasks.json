{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build debug",
			"type": "shell",
			"command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"clear": true,
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build debug-allocate",
			"type": "shell",
			"command": "cmake -B build -DCMAKE_BUILD_TYPE=Debug -DDEBUG_ALLOCATE=ON && cmake --build build",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"clear": true,
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build release",
			"type": "shell",
			"command": "cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"clear": true,
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "build target",
			"type": "shell",
			"command": "cmake --build build --target ${fileBasenameNoExtension}",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"clear": true,
				"reveal": "always"
			},
			"problemMatcher": "$gcc"
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "cmake --build build --target clean",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		}
	]
}
