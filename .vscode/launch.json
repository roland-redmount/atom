{
	// See https://code.visualstudio.com/docs/debugtest/debugging-configuration for documentation
	//
	// Both configs use ${fileBasenameNoExtension} as the program name, so opening any
	// test_*.c file and pressing F5 launches the corresponding binary from build/bin/.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug test (macOS / lldb)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/${fileBasenameNoExtension}",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "lldb"
		},
		{
			"name": "Debug test (Linux / gdb)",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/${fileBasenameNoExtension}",
			"args": [],
			"stopAtEntry": false,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		}
	]
}
